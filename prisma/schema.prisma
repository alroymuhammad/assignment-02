model RecipeJob {
    id          String   @id @default(uuid())
    ingredients String
    goal        String
    status      String
    createdAt   DateTime @default(now())
}

model RecipeResult {
    id                          String   @id @default(uuid())
    name                        String
    description                 String
    ingredients                 String[]
    instructions                String[]
    estimatedCaloriesPerServing Int
    recipeJobId                 String
}
